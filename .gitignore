# Code-only repository: deny by default, then allow reviewed source locations.
# Adding a new source folder requires an explicit rule here. Do not use git add -f
# for captures, phase maps, credentials, dependencies, or generated outputs.
*
!/.gitignore
!/README.md
!/*.py
!/*.ps1
!/*.md
!/*.json
/*_metadata.json
/stereo_depth_theory_summary.json

!/20260820/
!/20260820/*.py
!/20260820/*.md
!/20260820/*.json
!/20260820/*.sh
!/20260820/*.pbs
/20260820/claude-project-sindy-project.md

!/Acoustools_INFINICAM_sample/
!/Acoustools_INFINICAM_sample/*.py
!/Heart_Trajectory_Test/
!/Heart_Trajectory_Test/*.py
!/Heart_Trajectory_Test/*.md
!/measurement_control_b1_20260901/
!/measurement_control_b1_20260901/*.py
!/measurement_control_b1_20260901/*.md

!/hologram_optimization_package/
!/hologram_optimization_package/*.py
!/hologram_optimization_package/*.md
!/hologram_reoptimized_eps10mm_rho24p8_20260910/
!/hologram_reoptimized_eps10mm_rho24p8_20260910/*.py
!/hologram_reoptimized_eps10mm_rho24p8_20260910/*.md
!/hologram_reoptimized_eps10mm_rho24p8_20260910/physics/
!/hologram_reoptimized_eps10mm_rho24p8_20260910/physics/*.py

!/Ossila_LinearStage_Python_sample/
!/Ossila_LinearStage_Python_sample/*.py
!/Ossila_LinearStage_Python_sample/*.md
!/Ossila_LinearStage_Python_sample/requirements.txt
!/Ossila_LinearStage_Python_sample/ossila_stage/
!/Ossila_LinearStage_Python_sample/ossila_stage/*.py

!/plan_b_20260825/
!/plan_b_20260825/*.py
!/plan_b_20260825/*.md
!/plan_b_20260825/*.json
!/archive/
!/archive/*.py
!/archive/genx320/
!/archive/genx320/*.py
!/archive/genx320/*.ps1
!/archive/genx320/*.md
/archive/genx320/GENX320_RPI5_SETUP_NOTES.md
!/hf_identification_handoff_20260817/
!/hf_identification_handoff_20260817/*.py
!/hf_identification_handoff_20260817/*.md

# vzr identification campaign (2026-09-17): plan, reference plan/generator copies, and the
# numerical comparison record. The generated export_vzr_identification/ stays ignored.
!/vzr_identification_20260917/
!/vzr_identification_20260917/*.py
!/vzr_identification_20260917/*.md
!/vzr_identification_20260917/*.json

# Large single-axis step campaign (2026-09-20): plan, reference generator/plan copies and the
# comparison record. The generated export_large_step/ stays ignored.
!/large_step_20260920/
!/large_step_20260920/*.py
!/large_step_20260920/*.md
!/large_step_20260920/*.json

# Step-type vzr campaign (2026-09-19): plan, reference plan/generator copies, and the
# comparison record. The generated export_vzr_step/ stays ignored.
!/vzr_step_20260919/
!/vzr_step_20260919/*.py
!/vzr_step_20260919/*.md
!/vzr_step_20260919/*.json

# FF heart validation campaign (2026-09-18): plan, reference README/generator/metrics copies,
# and the comparison record. source/*.npz and export_ff_heart/ stay ignored.
!/ff_heart_20260918/
!/ff_heart_20260918/*.py
!/ff_heart_20260918/*.md
!/ff_heart_20260918/*.json

# Standalone camera-only code and instructions; keep SDKs/captures/calibration outputs ignored.
!/eventcam_standalone/
!/eventcam_standalone/.gitignore
!/eventcam_standalone/*.py
!/eventcam_standalone/*.ps1
!/eventcam_standalone/*.md
!/eventcam_standalone/*.json
!/eventcam_standalone/requirements.txt

# Preserve the comparison source, but not its numerical or image outputs.
!/visualizations/
!/visualizations/phase13mg_boards_comparison_20260910/
!/visualizations/phase13mg_boards_comparison_20260910/compare_maps.py
!/visualizations/phase13mg_boards_comparison_20260910/README_JP.md

# Defense in depth for private settings and credential material.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
*service_account*.json
secrets*.json
*.local.json
